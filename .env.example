# OPTIONAL: you do NOT need this to deploy.
#
# The backend base URL is hard-coded to the production Allomancy customer API
# (https://integrations.allomancy.net) in src/api/customerClient.ts, so a fresh
# fork works with zero config. Set VITE_API_BASE_URL ONLY to override it for local
# development against your own mock backend.
#
#   cp .env.example .env
#
# Local dev example:
# VITE_API_BASE_URL=https://localhost:7083
