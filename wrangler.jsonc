{
  // Cloudflare Workers Static Assets config for this static SPA (no server code).
  // The "Deploy to Cloudflare" button and `wrangler deploy` both use this model.
  // `not_found_handling: "single-page-application"` serves index.html for unknown
  // paths (client-side routing), so no `_redirects` file is needed.
  "name": "allomancy-customer-page",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
